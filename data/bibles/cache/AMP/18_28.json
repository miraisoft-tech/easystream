[{"verse":1,"text":""},{"verse":2,"text":""},{"verse":3,"text":""},{"verse":4,"text":""},{"verse":5,"text":""},{"verse":6,"text":""},{"verse":7,"text":""},{"verse":8,"text":""},{"verse":9,"text":""},{"verse":10,"text":""},{"verse":11,"text":""},{"verse":12,"text":""},{"verse":13,"text":""},{"verse":14,"text":""},{"verse":15,"text":""},{"verse":16,"text":""},{"verse":17,"text":""},{"verse":18,"text":""},{"verse":19,"text":""},{"verse":20,"text":""},{"verse":21,"text":""},{"verse":22,"text":"\"Abaddon (the place of destruction) and Death say, 'We have [only] heard a report of it with our ears.'"},{"verse":23,"text":""},{"verse":24,"text":""},{"verse":25,"text":""},{"verse":26,"text":""},{"verse":27,"text":""},{"verse":28,"text":"\"But to man He said, 'Behold, the reverential and worshipful fear of the Lord—that is wisdom; And to depart from evil is understanding.'\""}]