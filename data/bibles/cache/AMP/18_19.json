[{"verse":1,"text":"Then Job answered and said,"},{"verse":2,"text":""},{"verse":3,"text":""},{"verse":4,"text":""},{"verse":5,"text":""},{"verse":6,"text":""},{"verse":7,"text":""},{"verse":8,"text":""},{"verse":9,"text":""},{"verse":10,"text":""},{"verse":11,"text":""},{"verse":12,"text":"\"His troops come together And build up their way and siege works against me And camp around my tent."},{"verse":13,"text":""},{"verse":14,"text":""},{"verse":15,"text":""},{"verse":16,"text":""},{"verse":17,"text":""},{"verse":18,"text":""},{"verse":19,"text":""},{"verse":20,"text":""},{"verse":21,"text":""},{"verse":22,"text":""},{"verse":23,"text":""},{"verse":24,"text":""},{"verse":25,"text":""},{"verse":26,"text":""},{"verse":27,"text":""},{"verse":28,"text":""},{"verse":29,"text":"\"Then beware and be afraid of the sword [of divine vengeance] for yourselves, For wrathful are the punishments of that sword, So that you may know there is judgment.\""}]